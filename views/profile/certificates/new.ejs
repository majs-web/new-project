<!DOCTYPE html>
<html lang="en">
<%- include('../includes/head', {title: 'New Certificate | Bondeappen'}) %>
<body>
    <%- include('../includes/header') %>

    <div class="container">
        <h2>Add new certificate</h2>
        <section class="contact-form">
            <form action="/certificates/new" method="POST">
                <input type="text" name="name" placeholder="Name" required /><br />
                <input type="date" name="date" placeholder="Date" required /><br />
                <input type="text" name="description" placeholder="Description" required /><br />
                <button class="form-button">Save</button><br />
            </form>
        </section>
        <a class="login-button" href="/profile">Back</a>
        <a class="login-button" href="/certificates">See all certificates</a>
    </div>

    <%- include('../includes/footer') %>

</body>
</html>